# ── Provider Selection ────────────────────────────────────────────────────────
# Which inference backend to use. The push script sets agents.defaults.model.primary
# based on this value.
#
# Options: "azure", "copilot", "openrouter"
OPENCLAW_PROVIDER=

# ── Azure OpenAI (OPENCLAW_PROVIDER=azure) ──────────────────────────────────
# Uses GPT-5.4 deployment on Azure OpenAI.
# Requires NODE_OPTIONS preload for API version — the push script reminds you.
#
# Retrieve key:
#   az cognitiveservices account keys list \
#     --name oai-ss-aisense-dev-eastus2 \
#     --resource-group rg-ss-aisense-dev-eastus2 \
#     --query key1 -o tsv
#
# Or: Azure Portal → Azure OpenAI → oai-ss-aisense-dev-eastus2 → Keys and Endpoint
AZURE_OAI_API_KEY=

# ── GitHub Copilot (OPENCLAW_PROVIDER=copilot) ──────────────────────────────
# Auth: run `openclaw github-copilot login` (OAuth device flow).
# Token is stored in auth-profiles.json — no env var needed.
# Optional fallback: GH_TOKEN or GITHUB_TOKEN env vars also work.
#
# Model (defaults to claude-sonnet-4.6 if not set):
#   Claude:  claude-sonnet-4.6, claude-opus-4.6
#   GPT:     gpt-4o, gpt-4.1, gpt-5, gpt-5.4
#   Gemini:  gemini-2.5-pro, gemini-3.1-pro-preview
#   Other:   o3-mini, grok-3
COPILOT_MODEL=

# ── OpenRouter (OPENCLAW_PROVIDER=openrouter) ────────────────────────────────
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model (defaults to anthropic/claude-sonnet-4-20250514 if not set):
#   anthropic/claude-sonnet-4-20250514, openai/gpt-4.1, google/gemini-2.5-flash-preview
OPENROUTER_MODEL=
