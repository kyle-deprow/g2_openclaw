[Unit]
Description=G2 research owner loop
After=openclaw-gateway.service
BindsTo=openclaw-gateway.service
# BindsTo deliberately stops this owner when the gateway goes away.  Recovery
# is an explicit operator restart after gateway health is restored; this unit
# does not create an automatic second-start loop.

[Service]
Type=simple
ExecStart=@REPO_ROOT@/.venv/bin/gateway-cli research serve --root "@RESEARCH_V2_ROOT@" --session-key agent:research-orchestrator:autoresearch:quantipy-v2 --poll-seconds 60
EnvironmentFile=@REPO_ROOT@/.env
Restart=on-failure
RestartSec=30
# Exit 78 records a fatal owner failure with state PAUSED; do not loop-restart
# that deliberate pause. Ordinary crashes still use Restart=on-failure.
RestartPreventExitStatus=78
# The host queue worker is an owned child of this driver.  A gateway restart
# must not kill a durable queued worker; explicit operator stop/cancel handles
# owned jobs before stopping the driver.
KillMode=process
UMask=0077

[Install]
WantedBy=default.target
