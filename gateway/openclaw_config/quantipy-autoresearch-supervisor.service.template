[Unit]
Description=Quantipy Autoresearch Infrastructure Supervisor
After=openclaw-gateway.service
Requires=openclaw-gateway.service
BindsTo=openclaw-gateway.service
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=@REPO_ROOT@
Environment=HOME=@HOME@
Environment=PATH=@PATH@
ExecStart=@PYTHON_BIN@ -m gateway.autoresearch_supervisor --interval 60 --grace 120 --log-level INFO
Restart=on-failure
RestartSec=30
TimeoutStopSec=30
KillMode=control-group

[Install]
WantedBy=default.target
