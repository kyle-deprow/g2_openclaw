{
  "models": {
    "providers": {
      "azure-oai-g2": {
        "baseUrl": "https://aisvc-ss-aisense-dev-eastus2.openai.azure.com/openai/deployments/model-router",
        "api": "openai-completions",
        "apiKey": "env:AZURE_AI_SERVICES_API_KEY",
        "models": [
          {
            "id": "model-router",
            "name": "Model Router (Azure AI Services, eastus2)",
            "contextWindow": 1047576,
            "maxTokens": 16384,
            "input": ["text"],
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 },
            "reasoning": false
          }
        ]
      },
      "openrouter": {
        "baseUrl": "https://openrouter.ai/api/v1",
        "api": "openai-completions",
        "apiKey": "env:OPENROUTER_API_KEY",
        "models": [
          {
            "id": "anthropic/claude-sonnet-4-20250514",
            "name": "Claude Sonnet 4 (via OpenRouter)",
            "contextWindow": 200000,
            "maxTokens": 16384,
            "input": ["text"],
            "reasoning": false
          },
          {
            "id": "openai/gpt-4.1",
            "name": "GPT-4.1 (via OpenRouter)",
            "contextWindow": 1047576,
            "maxTokens": 32768,
            "input": ["text"],
            "reasoning": false
          },
          {
            "id": "google/gemini-2.5-flash-preview",
            "name": "Gemini 2.5 Flash Preview (via OpenRouter)",
            "contextWindow": 1048576,
            "maxTokens": 65536,
            "input": ["text"],
            "reasoning": false
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "github-copilot/claude-sonnet-4.6"
      },
      "compaction": {
        "mode": "safeguard"
      },
      "maxConcurrent": 4,
      "subagents": {
        "maxConcurrent": 8
      }
    }
  },
  "tools": {
    "profile": "full",
    "allow": [
      "Read", "Write", "Glob", "Grep", "exec",
      "memory_search",
      "web_search", "web_fetch",
      "copilot", "copilot_sessions"
    ]
  },
  "session": {
    "dmScope": "per-channel-peer"
  },
  "messages": {
    "ackReactionScope": "group-mentions"
  },
  "commands": {
    "native": "auto",
    "nativeSkills": "auto",
    "restart": true,
    "ownerDisplay": "raw"
  }
}
