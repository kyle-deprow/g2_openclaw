{
	"name": "copilot-bridge",
	"version": "0.1.0",
	"description": "GitHub Copilot SDK bridge for OpenClaw",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"engines": {
		"node": ">=22.0.0"
	},
	"scripts": {
		"build": "tsc",
		"lint": "biome check .",
		"format": "biome format . --write",
		"test": "vitest run",
		"test:integration": "COPILOT_INTEGRATION=1 OPENCLAW_INTEGRATION=1 vitest run tests/integration",
		"typecheck": "tsc --noEmit",
		"validate": "tsx scripts/validate-connection.ts",
		"register": "tsx scripts/register-plugin.ts",
		"unregister": "tsx scripts/register-plugin.ts --unregister",
		"register:mcp": "tsx scripts/register-mcp.ts",
		"unregister:mcp": "tsx scripts/register-mcp.ts --unregister"
	},
	"dependencies": {
		"@github/copilot-sdk": "^0.1.25",
		"@modelcontextprotocol/sdk": "^1.26.0",
		"@sinclair/typebox": "^0.34.48",
		"dotenv": "^17.3.1",
		"zod": "^4.3.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.6",
		"@types/node": "^25.3.0",
		"tsx": "^4.19.2",
		"typescript": "^5.7.3",
		"vitest": "^4.0.18"
	},
	"openclaw": {
		"extensions": [
			"./src/plugin.ts"
		]
	}
}
