{
  "name": "g2-openclaw-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:sim": "vite --mode simulator --host 127.0.0.1",
    "dev:network": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "qr": "evenhub qr --http --port 5173",
    "pack": "npm run build && evenhub pack app.json dist -o g2-openclaw.ehpk"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.11"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.1.13",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  }
}
